# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=purepsf
POSTGRES_USER=purepsf
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgres://purepsf:change_me_locally@localhost:5432/purepsf?sslmode=disable

# URA Data Service API
# Get yours at https://www.developer.tech.gov.sg/products/categories/data-and-apis/ura-apis/getting-started
URA_ACCESS_KEY=

# OneMap
# Get yours at https://www.onemap.gov.sg (sign up → email/password → POST to /api/auth/post/getToken)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Backend
BACKEND_PORT=8080
BACKEND_LOG_LEVEL=info

# Frontend (Vite reads VITE_-prefixed vars)
# Dev only — production docker stack relies on nginx reverse-proxy so the
# SPA hits /api on the same origin (no env needed in the prod build).
VITE_API_BASE_URL=http://localhost:8080

# Port the production nginx container publishes on (only the frontend
# is exposed to the host; backend & postgres live on the internal network).
FRONTEND_PORT=80
